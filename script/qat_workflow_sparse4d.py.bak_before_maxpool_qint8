        choices=["none", "pytorch"],
        default="none",
    )
    parser.add_argument(
        "--local_rank",
        "--local-rank",
        type=int,
        default=0,
        dest="local_rank",
    )

    parser.add_argument(
        "--phase",
        choices=["calib", "train", "all"],
        default=None,
    )
    parser.add_argument(
        "--qat-lr",
        type=float,
        default=1e-5,
    )
    parser.add_argument(
        "--qat-epochs",
        type=int,
        default=20,
    )
    parser.add_argument(
        "--qat-warmup-iters",
        type=int,
        default=100,
    )
    parser.add_argument(
        "--save-interval",
        type=int,
        default=None,
    )
    parser.add_argument(
        "--val-interval",
        type=int,
        default=None,
    )
    parser.add_argument(
        "--no-validate",
        action="store_true",
    )

    args = parser.parse_args()

    if "LOCAL_RANK" not in os.environ:
        os.environ["LOCAL_RANK"] = str(args.local_rank)

    return args


def _get_work_dir(cfg):
    return cfg.get(
        "work_dir",
        osp.join(
            "./e2e_worklog",
            osp.splitext(
                osp.basename(cfg.filename)
            )[0]
            if hasattr(cfg, "filename")
            else "sparse4d",
        ),
    )


def _build_model(cfg, checkpoint):
    """
    SparseEnd2End test.py model path:
        build_module(cfg["model"])
        wrap_fp16_model()
        load_checkpoint()
    """
    model = build_module(cfg["model"])

    fp16_cfg = cfg.get("fp16", None)
    if fp16_cfg is not None:
        wrap_fp16_model(model)

    load_checkpoint(
        model,
        checkpoint,
        map_location="cpu",
    )

    model = model.cuda()

    set_march("nash-p")

    model.eval()
    replace_forward_with_horizon(model)

    return model


@torch.no_grad()
def quant_analysis(float_model, calib_model, example_input):
    """
    Kept in the same spirit as SparseDrive QAT.

    Disabled by default; enable manually when you need sensitivity analysis.
    """
    try:
        from horizon_plugin_profiler import QuantAnalysis
    except ImportError:
        print("[QuantAnalysis] horizon_plugin_profiler is not available.")
        return

    set_fake_quantize(
        calib_model,
        FakeQuantState.VALIDATION,
    )

    qa = QuantAnalysis(
        baseline_model=float_model,
        analysis_model=calib_model,
        analysis_model_type="fake_quant",
        device_ids=0,
        out_dir=DEBUG_PATH,
    )
    qa.set_bad_case(example_input)
    qa.sensitivity(
        reverse=True,
        prefixes=("head.layers",),
    )


def horizon_export(calib_model, example_input):
    set_fake_quantize(
        calib_model,
        FakeQuantState.VALIDATION,
    )

    hbir_model = export(
        calib_model,
        example_input,
    )

    save(
        hbir_model,
        QAT_BC,
    )

    del calib_model
    del example_input

    torch.cuda.empty_cache()

    convert_start = time.time()

    quantized_hbir = convert(
        hbir_model,
        march="nash-p",
        advice=True,
        advice_path=ADVICE_PATH,
    )

    convert_end = time.time()

    print(
        "convert_time: ",
        convert_end - convert_start,
    )

    quantized_hbir[0].remove_io_op(
        op_types=[
            "Quantize",
            "Dequantize",
            "Cast",
            "Reshape",
        ]
    )

    save(
        quantized_hbir,
        QUANTIZE_BC,
    )

    compile_start = time.time()

    compile(
        quantized_hbir,
        path=HBM_PATH,
        march="nash-p",
        jobs=96,
        debug=True,
        progress_bar=True,
        opt=2,
    )

    compile_end = time.time()

    print(
        "compile_time: ",
        compile_end - compile_start,
    )


