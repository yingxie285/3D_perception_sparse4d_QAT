    if cached_feature is not None:
        cached_feature = cached_feature.detach()

    if cached_anchor is not None:
        cached_anchor = cached_anchor.detach()

    if cache_confidence is not None:
        cache_confidence = cache_confidence.detach()

    if cache_track_id is not None:
        cache_track_id = cache_track_id.detach()

    if torch.is_tensor(prev_id):
        prev_id = prev_id.detach()

    init_cached_feature = cached_feature
    init_cached_anchor = cached_anchor
    init_cache_confidence = cache_confidence
    init_cache_track_id = cache_track_id
    init_prev_id = prev_id
#-------------------------------------------------------------------------------
    prev_timestamp = None
    prev_t_global = None

    iteration = 0

    for epoch in range(args.qat_epochs):
        # Reset temporal state at the beginning of every epoch.
#---------------------------0929------------------------------------------------
        # det_cached_feature = init_det_cached_feature
        # det_cached_anchor = init_det_cached_anchor
        # det_cache_confidence = init_det_cache_confidence
        # det_cache_instance_id = init_det_cache_instance_id
        # prev_id = init_prev_id
        cached_feature = init_cached_feature
        cached_anchor = init_cached_anchor
        cache_confidence = init_cache_confidence
        cache_track_id = init_cache_track_id
        prev_id = init_prev_id
#-------------------------------------------------------------------------------

        prev_timestamp = None
        prev_t_global = None

        for data in train_loader:
            iteration += 1

            data = _extract_from_dc(data)

#----------------------------------------0929-----------------------------------
            # img = data["img"]
            # timestamp = data["timestamp"]
            # img_metas = data["img_metas"]

            # projection_mat = data.get(
            #     "projection_mat",
            #     data.get("lidar2img"),
            # )
            # image_wh = data["image_wh"]
            img = data["img"].cuda()
            timestamp = data["timestamp"].cuda()
            img_metas = data["img_metas"]

            cam_extrinsic = data["cam_extrinsic"].cuda()
            cam_intrinsic = data["cam_intrinsic"].cuda()
            cam_distortion = data["cam_distortion"].cuda()
            image_wh = data["image_wh"].cuda()
#-------------------------------------------------------------------------------

            cur_t_global = (
