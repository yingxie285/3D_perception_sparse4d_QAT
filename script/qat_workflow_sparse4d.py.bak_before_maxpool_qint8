                if time_gap > max_time_gap:
                    cached_feature = init_cached_feature
                    cached_anchor = init_cached_anchor
                    cache_confidence = init_cache_confidence
                    cache_track_id = init_cache_track_id
                    prev_id = init_prev_id
                    prev_t_global = None
#-------------------------------------------------------------------------------

#-------------------------------0929--------------------------------------------
