            #     det_cached_feature=det_cached_feature,
            #     det_cached_anchor=det_cached_anchor,
            #     det_cache_confidence=det_cache_confidence,
            #     det_cache_instance_id=det_cache_instance_id,
            #     prev_id=prev_id,
            # )
            det_output = calib_model(
                img=img,
                cam_extrinsic=cam_extrinsic,
                cam_intrinsic=cam_intrinsic,
                cam_distortion=cam_distortion,
                image_wh=image_wh,
                time_interval=time_interval.to(
                    torch.float32
                ),
                T_temp2cur=T_temp2cur,
                cached_feature=cached_feature,
                cached_anchor=cached_anchor,
                cache_confidence=cache_confidence,
                cache_track_id=cache_track_id,
                prev_id=prev_id,
            )
#-------------------------------------------------------------------------------

#------------------------------------0929---------------------------------------
            # with torch.no_grad():
            #     det_cached_feature = (
            #         det_output.get("cached_feature")
            #         if det_output
            #         else None
            #     )
            #     det_cached_anchor = (
            #         det_output.get("cached_anchor")
            #         if det_output
            #         else None
            #     )
            #     det_cache_confidence = (
            #         det_output.get("cache_confidence")
            #         if det_output
            #         else None
            #     )
            #     det_cache_instance_id = (
            #         det_output.get("cache_instance_id")
            #         if det_output
            #         else None
            #     )
            #     new_prev_id = (
            #         det_output.get("new_prev_id")
            #         if det_output
            #         else None
            #     )

            #     if det_cached_feature is not None:
            #         det_cached_feature = det_cached_feature.detach()
            #     if det_cached_anchor is not None:
            #         det_cached_anchor = det_cached_anchor.detach()
            #     if det_cache_confidence is not None:
            #         det_cache_confidence = det_cache_confidence.detach()
            #     if det_cache_instance_id is not None:
            #         det_cache_instance_id = det_cache_instance_id.detach()

            #     if new_prev_id is not None:
            #         if distributed:
            #             dist.all_reduce(
            #                 new_prev_id,
            #                 op=dist.ReduceOp.MAX,
            #             )
            #         prev_id = new_prev_id.detach()
            with torch.no_grad():

                new_cached_feature = det_output.get(
                    "cached_feature",
                    None,
                )

                new_cached_anchor = det_output.get(
                    "cached_anchor",
                    None,
                )

                new_cache_confidence = det_output.get(
                    "cache_confidence",
                    None,
                )

                new_cache_track_id = det_output.get(
                    "cache_track_id",
                    None,
                )

                new_prev_id = det_output.get(
                    "prev_id",
                    None,
                )

                if new_cached_feature is not None:
                    cached_feature = (
                        new_cached_feature.detach()
                    )

                if new_cached_anchor is not None:
                    cached_anchor = (
                        new_cached_anchor.detach()
                    )

                if new_cache_confidence is not None:
                    cache_confidence = (
                        new_cache_confidence.detach()
                    )

                if new_cache_track_id is not None:
                    cache_track_id = (
                        new_cache_track_id.detach()
                    )

                if new_prev_id is not None:
                    if distributed:
                        dist.all_reduce(
                            new_prev_id,
                            op=dist.ReduceOp.MAX,
                        )

                    prev_id = new_prev_id.detach()
#-------------------------------------------------------------------------------

            losses = compute_qat_loss(
                calib_model,
                det_output,
                data,
            )

            total_loss = sum(
                value.mean()
                for value in losses.values()
                if torch.is_tensor(value)
            )

            if not torch.isfinite(
                total_loss.detach()
            ).all():
                raise FloatingPointError(
                    f"Non-finite QAT loss at iteration "
                    f"{iteration}: {total_loss.item()}"
                )

            total_loss.backward()

            torch.nn.utils.clip_grad_norm_(
                inner.parameters(),
                max_norm=25,
            )

            optimizer.step()
            lr_scheduler.step(iteration)

            prev_timestamp = timestamp
            prev_t_global = cur_t_global

            if iteration % log_interval == 0:
                loss_str = "  ".join(
                    [
                        f"{k}: {v.mean().item():.4f}"
                        for k, v in losses.items()
                        if torch.is_tensor(v)
                    ]
                )
                lr = lr_scheduler.get_lr()
                print(
                    f"[QAT] iter {iteration}/{max_iters} "
                    f"lr={lr[0]:.2e} {loss_str}"
                )

            if iteration % save_interval == 0:
                save_qat_checkpoint(
                    calib_model,
                    iteration,
                    cfg["work_dir"]
                    if cfg.get("work_dir", None)
                    else WORK_DIR + PREFIEX,
                )

            # Keep the validation hook structure from SparseDrive, but use
            # the Sparse4D detection-only evaluator.
            if (
                not args.no_validate
                and iteration % val_interval == 0
            ):
                print(
                    f"[QAT] Validation at iter {iteration} ..."
                )

                if distributed:
                    if dist.get_rank() == 0:
                        val_loader = build_test_dataloader(
                            cfg,
                            distributed=False,
                        )
                        horizon_evaluate(
                            calib_model.module
                            if hasattr(
                                calib_model,
                                "module",
                            )
                            else calib_model,
                            val_loader,
                            cfg,
                            example_input=example_input,
                        )
                    if barrier_pg is not None:
                        dist.barrier(
                            group=barrier_pg
                        )
                else:
                    val_loader = build_test_dataloader(
                        cfg,
                        distributed=False,
                    )
                    horizon_evaluate(
                        calib_model,
                        val_loader,
                        cfg,
                        example_input=example_input,
                    )

                inner.train()
                set_fake_quantize(
                    inner,
                    FakeQuantState.QAT,
                )

            if iteration >= max_iters:
                break

        if iteration >= max_iters:
            break

    final_path = save_qat_checkpoint(
        calib_model,
        iteration,
        cfg["work_dir"]
        if cfg.get("work_dir", None)
        else WORK_DIR + PREFIEX,
    )

    print(
        f"[QAT] Training finished. Total iterations: {iteration}"
    )

    return final_path


def run_train_phase(args, cfg):
    print("=" * 60)
    print("[Phase 2] Multi-GPU QAT training")
    print("=" * 60)

#-------------------------------------------0929--------------------------------
    # if args.launcher == "none":
    #     distributed = False
    #     barrier_pg = None
    # else:
    #     distributed = True
    #     init_dist(
    #         args.launcher,
    #         **cfg["dist_params"],
    #     )
    #     barrier_pg = None
    if args.launcher == "none":
        distributed = False
        barrier_pg = None
    else:
        distributed = True
        barrier_pg = None
#-------------------------------------------------------------------------------

    example_input = torch.load(
        EXAMPLE_INPUT_PT,
        map_location="cuda",
        weights_only=False,
    )

    model = _build_model(
        cfg,
        args.checkpoint,
    )

    qconfig_setter = get_qconfig_setter(
        model
    )

    calib_model = prepare_calib_model(
        model,
        example_input,
        qconfig_setter,
    )

    calib_model.load_state_dict(
        torch.load(
            CALIBRATION_CKPT,
            map_location="cpu",
            weights_only=False,
        )
    )

    calib_model = calib_model.cuda()

    if distributed:
        calib_model = QATDDP(
            calib_model,
            device_ids=[
                torch.cuda.current_device()
            ],
            broadcast_buffers=False,
            find_unused_parameters=True,
        )
    else:
        calib_model = E2EDataParallel(
            calib_model,
            device_ids=[0],
        )

    train_dataset = build_module(
        cfg["data"]["train"]
    )

    train_loader = dataloader_wrapper(
        train_dataset,
        cfg["data"]["samples_per_gpu"],
        cfg["data"]["workers_per_gpu"],
        seed=cfg.get("seed", 0),
        runner_type=cfg["runner"]["type"],
        dist=distributed,
        num_gpus=len(cfg["gpu_ids"]),
        nonshuffler_sampler=dict(
            type="DistributedSampler"
        ),
    )

    inner = (
        calib_model.module
        if hasattr(calib_model, "module")
        else calib_model
    )

    optimizer = build_qat_optimizer(
        inner,
        args.qat_lr,
    )

    total_iters = (
        args.qat_epochs
        * len(train_loader)
    )

    lr_scheduler = QATLRScheduler(
        optimizer,
        warmup_iters=args.qat_warmup_iters,
        total_iters=total_iters,
    )

    return qat_train_loop(
        calib_model,
        optimizer,
        lr_scheduler,
        train_loader,
        example_input,
        args,
        cfg,
        distributed=distributed,
        barrier_pg=barrier_pg,
    )


def main():
    os.makedirs(
        WORK_DIR + PREFIEX,
        exist_ok=True,
    )

    args = parse_args()
    cfg = read_cfg(args.config)
    args.qat_epochs = getattr(cfg, 'qat_epochs', 20)

    # Same essential model setting as SparseEnd2End test.py.
    cfg["model"]["img_backbone"]["init_cfg"] = {}

    if cfg.get("work_dir", None) is None:
        cfg["work_dir"] = osp.join(
            "./e2e_worklog",
            osp.splitext(
                osp.basename(args.config)
            )[0],
        )

    os.makedirs(
        cfg["work_dir"],
        exist_ok=True,
    )

    if args.launcher == "none":
        distributed = False
        cfg["gpu_ids"] = range(1)
    elif args.launcher == "pytorch":
        distributed = True
        init_dist(
            args.launcher,
            **cfg["dist_params"],
        )
        _, world_size = get_dist_info()
        cfg["gpu_ids"] = range(world_size)
    else:
        raise NotImplementedError(
            f"not support {args.launcher} launcher."
        )

    # Keep random seed operation from SparseEnd2End test.py.
    set_random_seed(
        cfg.get("seed", 0),
        deterministic=args.deterministic,
    )

    # Phase is intentionally required, same as the supplied SparseDrive QAT
    # workflow.
    if args.phase == "calib":
        if distributed:
            raise RuntimeError(
                "calib phase must run with --launcher none."
            )

        run_calib_phase(
            args,
            cfg,
        )

    elif args.phase == "train":
        run_train_phase(
            args,
            cfg,
        )

    elif args.phase == "all":
        if distributed:
            raise RuntimeError(
                "all phase must be launched from the shell script, "
                "which runs calib first on one GPU and train afterwards."
            )

        run_calib_phase(
            args,
            cfg,
        )
        run_train_phase(args, cfg)

    else:
        raise ValueError(
            "--phase is required (calib, train, or all)"
        )


if __name__ == "__main__":
    torch.multiprocessing.set_start_method(
        "fork",
        force=True,
    )
    main()
