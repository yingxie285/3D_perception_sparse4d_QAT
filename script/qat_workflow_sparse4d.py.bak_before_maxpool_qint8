@torch.no_grad()
def run_calib_phase(args, cfg):
    print("=" * 60)
    print("[Phase 1] prepare -> calib -> eval -> export")
    print("=" * 60)

    data_loader = build_test_dataloader(
        cfg,
        distributed=False,
    )

    deploy_model = _build_model(
        cfg,
        args.checkpoint,
    )

    example_input = prepare_example_input(
        deploy_model,
        data_loader,
    )

    os.makedirs(
        osp.dirname(EXAMPLE_INPUT_PT),
        exist_ok=True,
    )
    torch.save(
        example_input,
        EXAMPLE_INPUT_PT,
    )

#------------------------------------0929 test----------------------------------
    print("\n" + "=" * 80)
    print("[MINIMAL TEST] example_input generated successfully")
    print("[MINIMAL TEST] saved to:", EXAMPLE_INPUT_PT)
    print("=" * 80)

    input_names = [
        "img",
        "cam_extrinsic",
        "cam_intrinsic",
        "cam_distortion",
        "image_wh",
        "time_interval",
        # "T_temp2cur",
        "cached_feature",
        "cached_anchor",
        "cache_confidence",
        "cache_track_id",
        "prev_id",
    ]

    print(
        "[MINIMAL TEST] number of inputs:",
        len(example_input),
    )

    for i, (name, value) in enumerate(
        zip(input_names, example_input)
    ):
        if torch.is_tensor(value):
            print(
                f"[{i:02d}] {name:20s} "
                f"shape={tuple(value.shape)} "
                f"dtype={value.dtype} "
                f"device={value.device} "
                f"min={value.min().item() if value.numel() > 0 else 'EMPTY'} "
                f"max={value.max().item() if value.numel() > 0 else 'EMPTY'}"
            )
        else:
            print(
                f"[{i:02d}] {name:20s} "
                f"value={value} "
                f"type={type(value)}"
            )

    assert len(example_input) == 11, (
        "Sparse4D example_input must contain 11 inputs, "
        f"but got {len(example_input)}"
    )

    none_inputs = [
        input_names[i]
        for i, value in enumerate(example_input)
        if value is None
    ]

    if none_inputs:
        raise RuntimeError(
            "[MINIMAL TEST] example_input contains None: "
            f"{none_inputs}"
        )

    print("\n[MINIMAL TEST] PASS")
    print(
        "[MINIMAL TEST] example_input interface is ready "
        "for Horizon prepare()."
    )
    print("=" * 80 + "\n")

    # ------------------------------------------------------------
    # DEBUG ONLY:
    # Stop before qconfig / prepare / calibration / export.
    # Remove this return after the minimal test passes.
    # ------------------------------------------------------------
    # return
#-------------------------------------------------------------------------------

    qconfig_setter = get_qconfig_setter(
        deploy_model
    )

    calib_model = prepare_calib_model(
        deploy_model,
        example_input,
        qconfig_setter,
    )

    calib_model.eval()

#-------------------------------------------1008 test---------------------------------------
    # ============================================================
    # QAT-02 prepared-model forward verification
    # ============================================================
    print(
        "[QAT-02] Running prepared-model forward verification..."
    )

    with torch.no_grad():
        _ = calib_model(*example_input)

    print(
        "[QAT-02] Prepared-model forward verification PASS."
    )
    # ============================================================
    # QAT-02 MINIMAL TEST
    # If execution reaches here, Horizon prepare() has succeeded.
    # Stop before calibration / evaluation / export.
    # ============================================================
    print("\n" + "=" * 80)
    print("[QAT-02] Horizon prepare() completed successfully.")
    print(
        "[QAT-02] calib_model type:",
        type(calib_model),
    )
    print(
        "[QAT-02] Stop before calibration / evaluation / export."
    )
    print(
        "[QAT-02] Check ./Horizon_Model/ for prepare reports."
    )
    print("=" * 80 + "\n")

    return
#-------------------------------------------------------------------------------------------

    horizon_calibration(
        calib_model,
        data_loader,
        example_input,
    )

    torch.save(
        calib_model.state_dict(),
        CALIBRATION_CKPT,
    )

    print(
        "[Calibration] checkpoint ->",
        CALIBRATION_CKPT,
    )

    # Keep SparseDrive structure: calibration result can be exported directly.
    horizon_export(
        calib_model,
        example_input,
    )

    print("[Phase 1] Done.")


def qat_train_loop(
    calib_model,
    optimizer,
    lr_scheduler,
    train_loader,
    example_input,
    args,
    cfg,
    distributed=False,
    barrier_pg=None,
):
    """
    Sparse4D detection-only QAT loop.

    SparseDrive-specific map / motion / planning states are removed.
    Detection temporal cache remains because Sparse4D uses propagated
    instances from previous frames.
    """
    inner = (
        calib_model.module
        if hasattr(calib_model, "module")
        else calib_model
    )

    iters_per_epoch = len(train_loader)
    max_iters = (
        args.qat_epochs
        * iters_per_epoch
    )

    save_interval = (
        args.save_interval
        or iters_per_epoch
    )

    val_interval = (
        args.val_interval
        or iters_per_epoch
    )

    log_interval = 50
    max_time_gap = 2.0

    print(
        f"[QAT] max_iters={max_iters}, "
        f"iters_per_epoch={iters_per_epoch}"
    )
    print(
        f"[QAT] save_interval={save_interval}, "
        f"val_interval={val_interval}"
    )

    inner.train()

    set_fake_quantize(
        inner,
        FakeQuantState.QAT,
    )

#------------------------------------------0929---------------------------------
    # (
    #     det_cached_feature,
    #     det_cached_anchor,
    #     det_cache_confidence,
    #     det_cache_instance_id,
    # ) = (
    #     example_input[5],
    #     example_input[6],
    #     example_input[7],
    #     example_input[8],
    # )

    # prev_id = example_input[9]

    # # Initial state is detached to make sure the training graph starts clean.
    # if det_cached_feature is not None:
    #     det_cached_feature = det_cached_feature.detach()
    # if det_cached_anchor is not None:
    #     det_cached_anchor = det_cached_anchor.detach()
    # if det_cache_confidence is not None:
    #     det_cache_confidence = det_cache_confidence.detach()
    # if det_cache_instance_id is not None:
    #     det_cache_instance_id = det_cache_instance_id.detach()
    # if torch.is_tensor(prev_id):
    #     prev_id = prev_id.detach()

    # init_det_cached_feature = det_cached_feature
    # init_det_cached_anchor = det_cached_anchor
    # init_det_cache_confidence = det_cache_confidence
    # init_det_cache_instance_id = det_cache_instance_id
    # init_prev_id = prev_id

    (
        cached_feature,
        cached_anchor,
        cache_confidence,
        cache_track_id,
        prev_id,
    ) = (
        example_input[7],
