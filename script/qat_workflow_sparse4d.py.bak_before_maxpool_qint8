def update_scale_by_qtype(model: torch.nn.Module):
    for _, m in model.named_modules():
        if isinstance(m, observer_v2.HistogramObserver):
            m.sync_histogram()

    for _, m in model.named_modules():
        if (
            isinstance(m, FakeQuantize)
            and m.observer_enabled
            and not isinstance(
                m.activation_post_process,
                (observer.FixedScaleObserver, observer_v2.FixedScaleObserver),
            )
        ):
            if (
                hasattr(m.activation_post_process, "histogram_edges")
                and m.activation_post_process.histogram_edges.numel() == 0
            ):
                continue
            m.reset_dtype()


def get_qconfig_setter(model=None):
    """
    Keep the SparseDrive QAT qconfig strategy, but adapt the detection-head
    module names from:

        head.det_head.layers.*

    to Sparse4D:

        head.layers.*

    Special thresholds are attached dynamically to modules that actually exist
    in the current Sparse4D implementation, avoiding hard-coded decoder indices.
    """
#------------------------------------------1008------------------------------------
    # templates = [
    #     ModuleNameTemplate({"": torch.float16}),
    #     ConvDtypeTemplate(
    #         input_dtype=qint16,
    #         weight_dtype=qint8,
    #     ),
    #     MatmulDtypeTemplate(
    #         input_dtypes=qint16,
    #     ),
    #     ConvDtypeTemplate(
    #         input_dtype=qint8,
    #         weight_dtype=qint8,
    #         prefix=["img_backbone", "img_neck"],
    #     ),
    # ]
    templates = [
        ModuleNameTemplate({"": torch.float16}),
        ConvDtypeTemplate(
            input_dtype=qint16,
            weight_dtype=qint8,
        ),
        MatmulDtypeTemplate(
            input_dtypes=qint16,
        ),
        ConvDtypeTemplate(
            input_dtype=qint8,
            weight_dtype=qint8,
            prefix=["img_backbone", "img_neck"],
        ),

        # Keep the stem -> layer1 boundary in INT8.
        # Otherwise SimplifyTemplate removes layer1.0 input quantization
        # while MaxPool still produces FP16.
        ModuleNameTemplate(
            {
                "img_backbone.maxpool": qint8,
            }
        ),
    ]
#----------------------------------------------------------------------------------

    if model is not None:
        module_names = dict(model.named_modules()).keys()

        for name in module_names:
            if name.endswith("float_func_div.mul"):
                templates.append(
                    ModuleNameTemplate(
                        {
                            name: {
                                "threshold": 2048
                            }
                        }
                    )
                )

            if name.endswith("float_func_div_wh.mul"):
                templates.append(
                    ModuleNameTemplate(
                        {
                            name: {
                                "threshold": 1.0625
                            }
                        }
                    )
                )

            if name.endswith("matmul_test"):
                templates.append(
                    ModuleNameTemplate(
                        {
                            name: {
                                "dtype": {
                                    "input": [qint8, qint8],
                                    "output": qint8,
                                }
                            }
                        }
                    )
                )

                generated_sum_name = name.rsplit(".", 1)[0] + "._generated_sum_0"
                if generated_sum_name in module_names:
                    templates.append(
                        ModuleNameTemplate(
                            {
                                generated_sum_name: qint16
                            }
                        )
                    )

    return QconfigSetter(
        get_qconfig(
            observer=observer_v2.HistogramObserver,
            fix_scale=False,
        ),
        templates=templates,
    )


