#         calib_iter += 1
#         print(
#             f"calibration iter : {calib_iter}"
#         )
@torch.no_grad()
def horizon_calibration(
    calib_model,
    data_loader,
    example_input,
    num_iters=6,
):
    calib_model.eval()

    set_fake_quantize(
        calib_model,
        FakeQuantState.CALIBRATION,
    )

    (
        cached_feature,
        cached_anchor,
        cache_confidence,
        cache_track_id,
        prev_id,
    ) = _initial_det_state(
        example_input
    )

    prev_timestamp = None
    prev_t_global = None

    calib_iter = 0

    for raw_data in data_loader:

        if calib_iter >= num_iters:
            break

        data = _extract_from_dc(raw_data)

        required_keys = [
            "img",
            "timestamp",
            "img_metas",
            "cam_extrinsic",
            "cam_intrinsic",
            "cam_distortion",
            "image_wh",
        ]

        missing_keys = [
            key
            for key in required_keys
            if key not in data
        ]

        if missing_keys:
            raise KeyError(
                "Sparse4D calibration data missing keys: "
                f"{missing_keys}. "
                f"Available keys: {list(data.keys())}"
            )

        img = data["img"]
        timestamp = data["timestamp"]
        img_metas = data["img_metas"]

        cam_extrinsic = data["cam_extrinsic"]
        cam_intrinsic = data["cam_intrinsic"]
        cam_distortion = data["cam_distortion"]
        image_wh = data["image_wh"]

        cur_t_global = _extract_t_global(
            img_metas
        )

        cur_t_global_inv = _extract_t_global_inv(
            img_metas
        )

        if prev_timestamp is None:

            time_interval = _tile_to_batch(
                example_input[5],
                img.shape[0],
            )

            # T_temp2cur = _tile_to_batch(
            #     example_input[6],
            #     img.shape[0],
            # )

        else:

            time_interval = (
                timestamp - prev_timestamp
            ).to(torch.float32)

            # T_temp2cur = _compute_T_temp2cur(
            #     cur_t_global_inv,
            #     prev_t_global,
            # )

        cached_feature = _tile_to_batch(
            cached_feature,
            img.shape[0],
        )

        cached_anchor = _tile_to_batch(
            cached_anchor,
            img.shape[0],
        )

        cache_confidence = _tile_to_batch(
            cache_confidence,
            img.shape[0],
        )

        cache_track_id = _tile_to_batch(
            cache_track_id,
            img.shape[0],
        )

        det_output = _run_det_forward(
            calib_model,
            img,
            cam_extrinsic,
            cam_intrinsic,
            cam_distortion,
            image_wh,
            time_interval,
            # T_temp2cur,
            cached_feature,
            cached_anchor,
            cache_confidence,
            cache_track_id,
            prev_id,
        )

        (
            cached_feature,
            cached_anchor,
            cache_confidence,
            cache_track_id,
            prev_id,
        ) = update_det_cache(
            det_output,
            prev_id,
            distributed=False,
        )

        prev_timestamp = timestamp
        prev_t_global = cur_t_global

        calib_iter += 1

        print(
            f"calibration iter : "
            f"{calib_iter}/{num_iters}"
        )
