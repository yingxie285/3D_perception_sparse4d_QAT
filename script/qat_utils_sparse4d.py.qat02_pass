@torch.no_grad()
def prepare_example_input(
    deploy_model,
    dataloader,
):
    """
    Build Sparse4D Horizon example_input.

    Layout:
        0  img
        1  cam_extrinsic
        2  cam_intrinsic
        3  cam_distortion
        4  image_wh
        5  time_interval
        6  cached_feature
        7  cached_anchor
        8  cache_confidence
        9  cache_track_id
        10 prev_id
    """

    raw_data = next(
        iter(dataloader)
    )

    data = _extract_from_dc(
        raw_data
    )

    required_keys = [
        "img",
        "cam_extrinsic",
        "cam_intrinsic",
        "cam_distortion",
        "image_wh",
    ]

    missing_keys = [
        key
        for key in required_keys
        if key not in data
    ]

    if missing_keys:
        raise KeyError(
            "Sparse4D QAT dataloader "
            "is missing required keys: "
            f"{missing_keys}. "
            f"Available keys: "
            f"{list(data.keys())}"
        )

    # ----------------------------------------------------------
    # Image
    #
    # Test pipeline returns:
    #     [Tensor(B, Ncam, C, H, W)]
    # Horizon model needs:
    #     Tensor(B, Ncam, C, H, W)
    # ----------------------------------------------------------
    img = data["img"]

    if isinstance(
        img,
        (list, tuple),
    ):
        if len(img) != 1:
            raise RuntimeError(
                "Sparse4D QAT only supports "
                "one test augmentation, "
                f"but got {len(img)}."
            )

        img = img[0]

    cam_extrinsic = data[
        "cam_extrinsic"
    ]

    cam_intrinsic = data[
        "cam_intrinsic"
    ]

    cam_distortion = data[
        "cam_distortion"
    ]

    image_wh = data[
        "image_wh"
    ]

    # ----------------------------------------------------------
    # InstanceBank information
    # ----------------------------------------------------------
    inner = (
        deploy_model.module
        if hasattr(
            deploy_model,
            "module",
        )
        else deploy_model
    )

    bank = inner.head.instance_bank

    batch_size = img.shape[0]
    device = img.device

#------------------------------0930----------------------------
    # num_temp_instances = (
    #     bank.num_temp_instances
    # )

    # num_anchor = bank.num_anchor

    # embed_dims = bank.embed_dims

    # anchor_dim = bank.anchor.shape[-1]
    num_temp_instances = (
        bank.num_temp_instances
    )

    num_anchor = bank.num_anchor
    embed_dims = bank.embed_dims
    anchor_dim = bank.anchor.shape[-1]

    # ----------------------------------------------------------
    # Deployment placeholder size for temporal-state I/O.
    #
    # In the current FP32 model:
    #
    #     bank.num_temp_instances == -1
    #
    # means temporal instances are disabled.  However, the
    # deployment interface temporarily keeps cached_feature /
    # cached_anchor / cache_confidence as explicit inputs.
    #
    # Therefore, use one dummy slot when temporal instances are
    # disabled.  These tensors are interface placeholders only
    # and must not participate in current-frame prediction.
    # ----------------------------------------------------------
    if num_temp_instances > 0:
        deploy_num_temp_instances = num_temp_instances
    else:
        deploy_num_temp_instances = 1
#-------------------------------------------------------------

    # ----------------------------------------------------------
    # Keep time_interval as deployment input.
    # Use FP32 model's default interval.
    # ----------------------------------------------------------
    time_interval = torch.full(
        (batch_size,),
        float(
            bank.default_time_interval
        ),
        dtype=torch.float32,
        device=device,
    )

    # ----------------------------------------------------------
    # Temporal-state placeholders.
    #
    # They are retained in deployment I/O but do not participate
    # in current-frame detection.
    # ----------------------------------------------------------
    cached_feature = torch.zeros(
        (
            batch_size,
            # num_temp_instances,
            deploy_num_temp_instances,
            embed_dims,
        ),
        dtype=bank.instance_feature.dtype,
        device=device,
    )

    cached_anchor = torch.zeros(
        (
            batch_size,
            # num_temp_instances,
            deploy_num_temp_instances,
            anchor_dim,
        ),
        dtype=bank.anchor.dtype,
        device=device,
    )

    cache_confidence = torch.zeros(
        (
            batch_size,
            # num_temp_instances,
            deploy_num_temp_instances,
        ),
        dtype=torch.float32,
        device=device,
    )

    cache_track_id = torch.full(
        (
            batch_size,
            num_anchor,
        ),
        -1,
        dtype=torch.int16,
        device=device,
    )

    prev_id = torch.tensor(
        0,
        dtype=torch.int32,
        device=device,
    )

    example_input = (
        img,                 # 0
        cam_extrinsic,       # 1
        cam_intrinsic,       # 2
        cam_distortion,      # 3
        image_wh,            # 4
        time_interval,       # 5
        cached_feature,      # 6
        cached_anchor,       # 7
        cache_confidence,    # 8
        cache_track_id,      # 9
        prev_id,             # 10
    )

    names = [
        "img",
        "cam_extrinsic",
        "cam_intrinsic",
        "cam_distortion",
        "image_wh",
        "time_interval",
        "cached_feature",
        "cached_anchor",
        "cache_confidence",
        "cache_track_id",
        "prev_id",
    ]

    print(
        "[prepare_example_input] "
        "Sparse4D 11-input interface ready."
    )

    for index, (
        name,
        value,
    ) in enumerate(
        zip(
            names,
            example_input,
        )
    ):
        print(
            f"  [{index:02d}] "
            f"{name}: "
            f"shape={tuple(value.shape)}, "
            f"dtype={value.dtype}, "
            f"device={value.device}"
        )

    return example_input
#-------------------------------------------------------------------------------

def replace_forward_with_horizon(module):
    if (
        hasattr(
            module,
            "horizon_forward",
        )
        and callable(
            module.horizon_forward
        )
    ):
        module.forward = (
            module.horizon_forward
        )

    for child in module.children():
        replace_forward_with_horizon(
            child
        )


def prepare_calib_model(
    inner,
    example_input,
    qconfig_setter,
):
    calib_model = prepare(
        inner,
        example_input,
        qconfig_setter,
        check_result_dir="./Horizon_Model/",
    )

    calib_model.eval()

    return calib_model


def _detach_tensor(value):
    if value is None:
        return None

    if torch.is_tensor(value):
        return value.detach()

    return value

#-----------------------------------------------0929----------------------------
# def _initial_det_state(example_input):
#     return (
#         _detach_tensor(example_input[5]),
#         _detach_tensor(example_input[6]),
#         _detach_tensor(example_input[7]),
#         _detach_tensor(example_input[8]),
#         _detach_tensor(example_input[9]),
#     )
def _initial_det_state(example_input):
    return (
        _detach_tensor(example_input[6]),   # cached_feature
        _detach_tensor(example_input[7]),   # cached_anchor
        _detach_tensor(example_input[8]),   # cache_confidence
        _detach_tensor(example_input[9]),   # cache_track_id
        _detach_tensor(example_input[10]),  # prev_id
    )
#-------------------------------------------------------------------------------

def _reset_state(example_input):
    return _initial_det_state(
        example_input
    )

