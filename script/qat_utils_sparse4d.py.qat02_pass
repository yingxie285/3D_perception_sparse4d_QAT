def update_det_cache(
    det_output,
    prev_id,
    distributed=False,
):

    cached_feature = _detach_tensor(
        _get_det_cache(
            det_output,
            "cached_feature",
        )
    )

    cached_anchor = _detach_tensor(
        _get_det_cache(
            det_output,
            "cached_anchor",
        )
    )

    cache_confidence = _detach_tensor(
        _get_det_cache(
            det_output,
            "cache_confidence",
        )
    )

    cache_track_id = _detach_tensor(
        _get_det_cache(
            det_output,
            "cache_track_id",
        )
    )

    new_prev_id = _get_det_cache(
        det_output,
        "prev_id",
    )

    if new_prev_id is not None:

        new_prev_id = _detach_tensor(
            new_prev_id
        )

        if (
            distributed
            and dist.is_initialized()
        ):
            dist.all_reduce(
                new_prev_id,
                op=dist.ReduceOp.MAX,
            )

        prev_id = new_prev_id

    return (
        cached_feature,
        cached_anchor,
        cache_confidence,
        cache_track_id,
        prev_id,
    )
#-------------------------------------------------------------------------------


def compute_qat_loss(
    calib_model,
    det_output,
    data,
):
    """
    Sparse4D itself is the perception/detection model.

    Its head receives the output dictionary containing:
        classification
        prediction
        quality
        optional denoising outputs

    and computes all detection losses.
    """
    model = (
        calib_model.module
        if hasattr(
            calib_model,
            "module",
        )
        else calib_model
    )

    return model.head.loss(
        det_output,
        data,
    )


def build_test_dataloader(
    cfg,
    distributed=False,
):
    samples_per_gpu = cfg["data"]["test"].pop(
        "samples_per_gpu",
        1,
    )

    dataset = build_module(
        cfg["data"]["test"]
    )

    if distributed:
        data_loader = dataloader_wrapper(
            dataset,
            samples_per_gpu=samples_per_gpu,
            workers_per_gpu=cfg["data"]["workers_per_gpu"],
            dist=True,
            shuffle=False,
            nonshuffler_sampler=dict(
                type="DistributedSampler"
            ),
        )
    else:
        data_loader = dataloader_wrapper_without_dist(
            dataset,
            samples_per_gpu=samples_per_gpu,
            workers_per_gpu=cfg["data"]["workers_per_gpu"],
            dist=False,
            shuffle=False,
        )

    return data_loader


def build_train_dataloader(
    cfg,
    distributed=False,
):
    train_dataset = build_module(
        cfg["data"]["train"]
    )

    return dataloader_wrapper(
        train_dataset,
        cfg["data"]["samples_per_gpu"],
        cfg["data"]["workers_per_gpu"],
        seed=cfg.get("seed", 0),
        runner_type=cfg["runner"]["type"],
        dist=distributed,
        num_gpus=len(cfg["gpu_ids"]),
        nonshuffler_sampler=dict(
            type="DistributedSampler"
        ),
    )


def build_qat_optimizer(
    calib_model,
    qat_lr,
    weight_decay=0.001,
):
    backbone_params = []
    other_params = []

    for name, param in calib_model.named_parameters():
        if not param.requires_grad:
            continue

        if (
            "img_backbone" in name
            or "img_neck" in name
        ):
            backbone_params.append(param)
        else:
            other_params.append(param)

    param_groups = [
        {
            "params": backbone_params,
            "lr": qat_lr * 0.1,
        },
        {
            "params": other_params,
            "lr": qat_lr,
        },
    ]

    optimizer = torch.optim.AdamW(
        param_groups,
        weight_decay=weight_decay,
    )

    for pg in optimizer.param_groups:
        pg["initial_lr"] = pg["lr"]

    return optimizer


class QATLRScheduler:
    """
    Cosine annealing with linear warmup.
    """

    def __init__(
        self,
        optimizer,
        warmup_iters,
        total_iters,
        min_lr_ratio=1e-3,
    ):
        self.optimizer = optimizer
        self.warmup_iters = warmup_iters
        self.total_iters = total_iters
        self.min_lr_ratio = min_lr_ratio

    def step(self, iteration):
        if iteration < self.warmup_iters:
            scale = (
                iteration + 1
            ) / self.warmup_iters
        else:
            progress = (
                iteration
                - self.warmup_iters
            ) / max(
                1,
                self.total_iters
                - self.warmup_iters,
            )

            scale = (
                self.min_lr_ratio
                + 0.5
                * (
                    1
                    - self.min_lr_ratio
                )
                * (
                    1
                    + np.cos(
                        np.pi
                        * progress
                    )
                )
            )

        for param_group in self.optimizer.param_groups:
            param_group["lr"] = (
                param_group["initial_lr"]
                * scale
            )

    def get_lr(self):
        return [
            pg["lr"]
            for pg in self.optimizer.param_groups
        ]


def save_qat_checkpoint(
    calib_model,
    iteration,
    work_dir,
):
    model = (
        calib_model.module
        if hasattr(
            calib_model,
            "module",
        )
        else calib_model
    )

    ckpt_dir = osp.join(
        work_dir,
        "qat_checkpoints",
    )

    os.makedirs(
        ckpt_dir,
        exist_ok=True,
    )

    path = osp.join(
        ckpt_dir,
        f"qat_iter_{iteration}.ckpt",
    )

    torch.save(
        model.state_dict(),
        path,
    )

    print(
        f"[save] -> {path}"
    )

    return path


@torch.no_grad()
def horizon_evaluate(
    calib_model,
    data_loader,
    cfg,
    example_input=None,
):
    calib_model.eval()

    set_fake_quantize(
        calib_model,
        FakeQuantState.VALIDATION,
    )

    inner = (
        calib_model.module
        if hasattr(
            calib_model,
            "module",
        )
        else calib_model
    )

    if example_input is not None:
        (
            det_cached_feature,
            det_cached_anchor,
            det_cache_confidence,
            det_cache_instance_id,
            prev_id,
        ) = _initial_det_state(
            example_input
        )
    else:
        (
            det_cached_feature,
            det_cached_anchor,
            det_cache_confidence,
            det_cache_instance_id,
            prev_id,
        ) = (
            None,
            None,
            None,
            None,
            torch.tensor(
                0,
                dtype=torch.int32,
                device="cuda",
            ),
        )

    prev_timestamp = None
    prev_t_global = None

    outputs = []

    for raw_data in data_loader:
        data = _extract_from_dc(
            raw_data
        )

        img = data["img"]
        timestamp = data["timestamp"]
        img_metas = data["img_metas"]
        projection_mat = _projection_mat(data)
        image_wh = data["image_wh"]

        cur_t_global = _extract_t_global(
            img_metas
        )
        cur_t_global_inv = _extract_t_global_inv(
            img_metas
        )

        if prev_timestamp is None:
            time_interval = (
                example_input[3]
                if example_input is not None
                else None
            )
            # T_temp2cur = (
            #     example_input[4]
            #     if example_input is not None
            #     else None
            # )
        else:
            time_gap = (
                timestamp - prev_timestamp
            ).abs().max().item()

            if time_gap > 2.0:
                (
                    det_cached_feature,
                    det_cached_anchor,
                    det_cache_confidence,
                    det_cache_instance_id,
                    prev_id,
                ) = (
                    _reset_state(
                        example_input
                    )
                    if example_input is not None
                    else (
                        None,
                        None,
                        None,
                        None,
                        torch.tensor(
                            0,
                            dtype=torch.int32,
                            device="cuda",
                        ),
                    )
                )

                time_interval = torch.zeros_like(
                    timestamp,
                    dtype=torch.float32,
                )
                prev_t_global = None
                # T_temp2cur = None
            else:
                time_interval = (
                    timestamp - prev_timestamp
                ).to(torch.float32)

                # T_temp2cur = _compute_T_temp2cur(
                #     cur_t_global_inv,
                #     prev_t_global,
                # )

        det_cached_feature = _tile_to_batch(
            det_cached_feature,
            img.shape[0],
        )
        det_cached_anchor = _tile_to_batch(
            det_cached_anchor,
            img.shape[0],
        )
        det_cache_confidence = _tile_to_batch(
            det_cache_confidence,
            img.shape[0],
        )
        det_cache_instance_id = _tile_to_batch(
            det_cache_instance_id,
            img.shape[0],
        )

        det_output = _run_det_forward(
            calib_model,
            img,
            projection_mat,
            image_wh,
            time_interval,
            # T_temp2cur,
            det_cached_feature,
            det_cached_anchor,
            det_cache_confidence,
            det_cache_instance_id,
            prev_id,
        )

        (
            det_cached_feature,
            det_cached_anchor,
            det_cache_confidence,
            det_cache_instance_id,
            prev_id,
        ) = update_det_cache(
            det_output,
            prev_id,
            distributed=False,
        )

        results = inner.head.post_process(
            det_output
        )

        outputs.extend(
            [
                {
                    "img_bbox": result
                }
                for result in results
            ]
        )

        prev_timestamp = timestamp
        prev_t_global = cur_t_global

    rank, _ = get_dist_info()

    if rank == 0:
        kwargs = {}

        eval_kwargs = cfg.get(
            "evaluation",
            {}
        ).copy()

        for key in ["interval"]:
            eval_kwargs.pop(
                key,
                None,
            )

        eval_kwargs.update(
            dict(
                metric="bbox",
                **kwargs,
            )
        )

        if (
            eval_kwargs.get(
                "jsonfile_prefix",
                None,
            )
            is None
        ):
            eval_kwargs["jsonfile_prefix"] = osp.join(
                "./e2e_worklog",
                osp.splitext(
                    osp.basename(
                        cfg.get(
                            "filename",
                            "sparse4d",
                        )
                    )
                )[0],
                "eval",
            )

        print(
            "\n",
            eval_kwargs,
        )

        results_dict = (
            data_loader.dataset.evaluate(
                outputs,
                **eval_kwargs,
            )
        )

        print(
            results_dict
        )

        return results_dict

    return outputs


def collect_results_cpu(
    result_part,
    size,
    tmpdir=None,
):
    rank, world_size = get_dist_info()

    if tmpdir is None:
        max_len = 512

        dir_tensor = torch.full(
            (max_len,),
            32,
            dtype=torch.uint8,
            device="cuda",
        )

        if rank == 0:
            os.makedirs(
                ".dist_test",
                exist_ok=True,
            )
            tmpdir = tempfile.mkdtemp(
                dir=".dist_test"
            )
            tmpdir_tensor = torch.tensor(
                bytearray(
                    tmpdir.encode()
                ),
                dtype=torch.uint8,
                device="cuda",
            )
            dir_tensor[
                :len(tmpdir_tensor)
            ] = tmpdir_tensor

        dist.broadcast(
            dir_tensor,
            0,
        )

        tmpdir = (
            dir_tensor.cpu()
            .numpy()
            .tobytes()
            .decode()
            .rstrip()
        )

    else:
        os.makedirs(
            tmpdir,
            exist_ok=True,
        )

    import pickle

    with open(
        osp.join(
            tmpdir,
            f"part_{rank}.pkl",
        ),
        "wb",
    ) as f:
        pickle.dump(
            result_part,
            f,
        )

    dist.barrier()

    if rank != 0:
        return None

    ordered_results = []

    for part_file in sorted(
        glob.glob(
            osp.join(
                tmpdir,
                "part_*.pkl",
            )
        )
    ):
        with open(
            part_file,
            "rb",
        ) as f:
            ordered_results.extend(
                pickle.load(f)
            )

    ordered_results = (
        ordered_results[:size]
    )

    shutil.rmtree(
        tmpdir,
        ignore_errors=True,
    )

    return ordered_results


def is_main_process():
    if (
        dist.is_available()
        and dist.is_initialized()
    ):
        return dist.get_rank() == 0

    return True
