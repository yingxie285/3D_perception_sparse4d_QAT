def _run_det_forward(
    model,
    img,
    cam_extrinsic,
    cam_intrinsic,
    cam_distortion,
    image_wh,
    time_interval,
    # T_temp2cur,
    cached_feature,
    cached_anchor,
    cache_confidence,
    cache_track_id,
    prev_id,
):
    """
    Sparse4D Horizon deployment forward.

    Keep this function strictly aligned with:

        Sparse4D.horizon_forward(
            img,
            cam_extrinsic,
            cam_intrinsic,
            cam_distortion,
            image_wh,
            time_interval,
            T_temp2cur,
            cached_feature,
            cached_anchor,
            cache_confidence,
            cache_track_id,
            prev_id,
        )
    """

    output = model(
        img=img,
        cam_extrinsic=cam_extrinsic,
        cam_intrinsic=cam_intrinsic,
        cam_distortion=cam_distortion,
        image_wh=image_wh,
        time_interval=time_interval,
        # T_temp2cur=T_temp2cur,
        cached_feature=cached_feature,
        cached_anchor=cached_anchor,
        cache_confidence=cache_confidence,
        cache_track_id=cache_track_id,
        prev_id=prev_id,
    )

    if isinstance(output, dict):
        return output

    if (
        isinstance(output, (tuple, list))
        and len(output) == 1
        and isinstance(output[0], dict)
    ):
        return output[0]

    raise TypeError(
        "Expected Sparse4D horizon_forward to return a dict, "
        f"but got {type(output)}"
    )
