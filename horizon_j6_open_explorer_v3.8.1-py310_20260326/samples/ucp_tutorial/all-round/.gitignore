# Source-only allowlist. ! means include again, NOT ignore.
/*
!/.gitignore
!/README.md
!/task.md
!/SPARSE4D_IMPLEMENTATION.md
!/CMakeLists.txt
!/build_sparse4d_aarch64.sh
!/build_sparse4d_x86.sh
!/run_sparse4d.sh
!/src/
/src/*
!/src/sparse4d/
!/include/
/include/*
!/include/sparse4d/
!/tools/
/tools/*
!/tools/sparse4d/
!/tests/
/tests/*
!/tests/sparse4d/
!/configs/
/configs/*
!/configs/sparse4d/
/configs/sparse4d/*
!/configs/sparse4d/model_io.json

# Generated artifacts even inside permitted source directories.
__pycache__/
*.pyc
*.exe
*.o
*.obj
*.a
*.so
*.so.*
*.dll
*.hbm
*.bc
*.pth
*.ckpt
*.bin
*.log
*.zip
*.tar
*.tar.gz
